{
  "name": "design-system",
  "version": "0.1.0",
  "private": true,
  "description": "개인 디자인 시스템 — shadcn/ui(Base UI) + Ollama 토큰 + 디자인 시스템 lint",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tools e2e --ignore-pattern \"tools/guard-fixtures/**\" --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:guards": "node tools/check-guards.mjs",
    "e2e": "playwright test",
    "check": "npm run lint && npm run check:guards && npm run typecheck && npm run test && npm run build",
    "registry:build": "node tools/registry/generate.mjs && shadcn build",
    "mockup:export": "node tools/mockups/export.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dagrejs/dagre": "^3.1.1",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.57.0",
    "next": "16.3.1",
    "pretendard": "^1.3.9",
    "react": "19.2.8",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.2.8",
    "react-resizable-panels": "^4.14.5",
    "shadcn": "^4.21.5",
    "shiki": "^4.5.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.62.1",
    "@shadcn/lint": "^0.2.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/parser": "^8.40.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "vite": "^8.3.4"
  },
  "license": "MIT"
}
